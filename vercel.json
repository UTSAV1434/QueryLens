{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/**"
    }
  },
  "routes": [
    {
      "src": "/(assets/.*)",
      "dest": "/frontend/$1"
    },
    {
      "src": "/(vite\\.svg)",
      "dest": "/frontend/$1"
    },
    {
      "src": "/api/(.*)",
      "continue": true
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/index.html"
    }
  ]
}
